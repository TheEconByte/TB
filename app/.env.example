# app/.env.local 예시. `npm --prefix app run bootstrap`이 임의 값으로 만들어 주므로 직접 만들 때만 참고한다.
# 비밀번호는 infra/.env의 POSTGRES_PASSWORD와 같게 두고, URL의 특수문자는 인코딩한다.
DATABASE_URL=postgresql://trendbench:change-this-local-password@127.0.0.1:5433/trendbench_mvp
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
# 상권 적재(market:load)에 필요하다. 서울 열린데이터광장 인증키를 넣는다.
SEOUL_OPEN_API_KEY=
# 소진공 점포 적재(business:load)에만 필요하다. 공공데이터포털 일반 인증키(Decoding)를 넣는다.
SEMAS_SERVICE_KEY=

# TEST_DATABASE_URL은 이 파일이 아니라 app/.env.test.local에 둔다. 하네스와 Vitest는 환경변수나 그 파일에서만 읽는다.
# TEST_DATABASE_URL=postgresql://trendbench:change-this-local-password@127.0.0.1:5433/trendbench_mvp_test
