{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env.local)",
      "Read(**/.env.test.local)",
      "Read(**/infra/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.test.local)",
      "Edit(**/infra/.env)",
      "Edit(**/prisma/migrations/*/migration.sql)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-commands.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
